      <aliases enabled='yes' />
      <column caption='Total population' datatype='integer' name='[Calculation_2102899574176169985]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Pop])' />
      </column>
      <column caption='Females' datatype='integer' name='[Calculation_2102899574176870402]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Sex] =&apos;Females&apos;&#13;&#10;THEN[Pop]&#13;&#10;END' />
      </column>
      <column caption='Males' datatype='integer' name='[Calculation_2102899574177095683]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Sex] =&apos;Males&apos;&#13;&#10;THEN[Pop]&#13;&#10;END' />
      </column>
      <column caption='Population density' datatype='real' name='[Calculation_2102899574178799620]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Pop])/SUM (AREA([Geometry],&apos;km&apos;))' />
      </column>
      <column caption='log 10PopDen' datatype='real' name='[Calculation_2102899574179438597]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='LOG([Calculation_2102899574178799620],10)' />
      </column>
      <column caption='log10  totpop' datatype='real' name='[Calculation_2102899574179561478]' role='measure' type='quantitative'>
